CRUSOE_API_KEY=
MODAL_VLLM_TOKEN=
MODAL_VLLM_URL=
CHIMERA_DB_URL=
# admin role (bypasses RLS): migrations only, never used by the app
CHIMERA_DB_ADMIN_URL=
CHIMERA_GRAPH_URL=
CHIMERA_GRAPH_USER=
CHIMERA_GRAPH_PASSWORD=
CHIMERA_GRAPH_DATABASE=
GITHUB_PERSONAL_ACCESS_TOKEN=
# local end of the SSH tunnel to your GPU box (Ollama), e.g. http://127.0.0.1:<port>
CHIMERA_GPU_URL=
# ssh alias of the GPU box (a Host entry in your ssh config); scripts/gpu_tunnel_keep.sh opens and heals the tunnel
CHIMERA_GPU_SSH=
# optional: Ollama address on the GPU box for the tunnel's far end (default 127.0.0.1:11434); bench/akash/chimera_ollama.sh serves the tuned 30B
CHIMERA_GPU_REMOTE=
# bearer token for an Ollama behind bench/a6000/auth_proxy.py (a public quick tunnel); the tier sets api_key_env = "CHIMERA_GPU_KEY"
CHIMERA_GPU_KEY=
# the previous CHIMERA_GPU_URL, kept while the A6000 tunnel is in use (bench/run_a6000.py)
CHIMERA_GPU_URL_AKASH=
# shared A6000 box for bench/run_a6000.py: ssh alias and the run folder on the box
A6000_SSH=
A6000_ROOT=
# Modal H200 Qwen3-30B app URL (deploy/modal/vllm_qwen30b.py); bearer token is MODAL_VLLM_TOKEN
MODAL_QWEN_URL=
# optional gpu-120b tier (docs/handoff/tier_120b.md): local end of the SSH tunnel to your 120B box, e.g. http://127.0.0.1:<port>
# Unset = the tier is off.
CHIMERA_120B_URL=
# the vLLM API key on that box (deploy/gpu120b/serve_vllm.sh reads the same value there)
CHIMERA_120B_KEY=
# ssh alias of the 120B box, for the tunnel (see the handoff note)
CHIMERA_120B_SSH=
DAYTONA_API_KEY=
ELEVENLABS_API_KEY=
