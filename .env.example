CRUSOE_API_KEY=
MODAL_VLLM_TOKEN=
MODAL_VLLM_URL=
CHIMERA_DB_URL=
# admin role (bypasses RLS): migrations only, never used by the app
CHIMERA_DB_ADMIN_URL=
CHIMERA_GRAPH_URL=
CHIMERA_GRAPH_USER=
CHIMERA_GRAPH_PASSWORD=
CHIMERA_GRAPH_DATABASE=
GITHUB_PERSONAL_ACCESS_TOKEN=
# local end of the SSH tunnel to your GPU box (Ollama), e.g. http://127.0.0.1:<port>
CHIMERA_GPU_URL=
# ssh alias of the GPU box (a Host entry in your ssh config); scripts/gpu_tunnel_keep.sh opens and heals the tunnel
CHIMERA_GPU_SSH=
# optional: Ollama address on the GPU box for the tunnel's far end (default 127.0.0.1:11434); bench/akash/chimera_ollama.sh serves the tuned 30B
CHIMERA_GPU_REMOTE=
# Modal H200 Qwen3-30B app URL (deploy/modal/vllm_qwen30b.py); bearer token is MODAL_VLLM_TOKEN
MODAL_QWEN_URL=
